UNIT unsetValue
KIND STATE
ORACLE-CLASS deterministic

# unsetValue is the default module.exports (CJS) of unset-value@2.0.1.
# It is PURE w.r.t. ambient sources (no clock/RNG/env/fs/net) -> deterministic, no seam.
# It is KIND STATE because it MUTATES its `obj` argument in place. The observable contract
# is therefore BOTH the return value AND the post-mutation state of `obj` (see ORACLE).

SIG  unsetValue(obj: any, prop: string | Array<any>) -> boolean   # throws on some inputs (see BEHAVIOR)

DEPENDS-ON  none
# All runtime dependencies are FOLDED IN (inlined) so the re-emitted unit is standalone with
# NO require()/import. The original chain is, for reference only (do NOT require these):
#   isobject@4.0.0        (index.cjs.js)  -> the `isObject` guard used by unsetValue itself
#   has-value@2.0.2       -> the `has` presence check; depends on:
#       get-value@3.0.1    (which depends on isobject@3.0.1, byte-identical to isobject@4's logic)
#       has-values@2.0.1   (which depends on kind-of@6.0.3)
# Their exact inlined logic is specified node-by-node below and demonstrated in SCOPE.

BEHAVIOR
  # ---- Helper definitions (inlined; referenced by the main pipeline) -----------------------
  #
  # H1. isObject(val)            # the isobject@4 guard used by unsetValue
  #     return  val != null  &&  typeof val === 'object'  &&  Array.isArray(val) === false
  #     # => true for plain objects, Date, RegExp, Map, Set, etc.; FALSE for null/undefined,
  #     #    numbers, strings, booleans, functions, and ARRAYS.
  #
  # H2. kindOf(val)              # kind-of@6.0.3, the subset reachable from has-values
  #     if val === undefined -> 'undefined'
  #     if val === null      -> 'null'
  #     t = typeof val
  #     if t === 'boolean'   -> 'boolean'
  #     if t === 'string'    -> 'string'
  #     if t === 'number'    -> 'number'
  #     if t === 'symbol'    -> 'symbol'
  #     if t === 'function'  -> 'function'   # (generator-fn refinement not reachable for codec inputs)
  #     if Array.isArray(val)-> 'array'
  #     if isBuffer(val)     -> 'buffer'     # Buffer.isBuffer
  #     if val instanceof Date  -> 'date'
  #     if val instanceof Error -> 'error'
  #     if val instanceof RegExp-> 'regexp'
  #     ctor = (typeof val.constructor === 'function') ? val.constructor.name : null
  #     switch ctor: 'Map'->'map'  'Set'->'set'  (plus Promise/WeakMap/typed-arrays, not codec inputs)
  #     ts = Object.prototype.toString.call(val)
  #     if ts === '[object Object]' -> 'object'
  #     else -> ts.slice(8,-1).toLowerCase().replace(/\s/g,'')
  #     # For the JSON/codec-faithful input envelope the only kinds that occur are:
  #     #   'undefined','null','boolean','string','number','array','object'
  #     #   (and 'map'/'set'/'buffer' if a Map/Set/Uint8Array is nested as a leaf value).
  #
  # H3. hasValues(val)           # has-values@2.0.1: "is there any non-empty value in here?"
  #     switch kindOf(val):
  #       'boolean' | 'date' | 'function' | 'null' | 'number' -> return true
  #       'undefined'                                         -> return false
  #       'regexp'  -> return val.source !== '(?:)' && val.source !== ''
  #       'buffer'  -> return val.toString() !== ''
  #       'error'   -> return val.message !== ''
  #       'string' | 'arguments' -> return val.length !== 0     # '' -> false
  #       'file' | 'map' | 'set' -> return val.size !== 0
  #       'array' | 'object'     -> for key of Object.keys(val): if hasValues(val[key]) return true
  #                                 return false                  # {} -> false, [] -> false, recursive
  #       default                -> return true
  #     # KEY CONSEQUENCES (codec envelope):
  #     #   number (incl. 0)        -> true        null  -> true        boolean (incl. false) -> true
  #     #   '' (empty string)       -> false       'x'   -> true
  #     #   {} / [] / nested-all-empty -> false (recursively)     {k:0} / [1] -> true
  #
  # H4. getValue(target, path, options)   # get-value@3.0.1 (options defaults to undefined here)
  #     # unsetValue always calls hasValue(obj, prop) with NO options, so options === undefined.
  #     gvIsObject(v) = v != null && typeof v === 'object' && !Array.isArray(v)
  #     if !gvIsObject(options): options = { default: options }      # -> { default: undefined }
  #     isValidObject(v) = gvIsObject(v) || Array.isArray(v) || typeof v === 'function'
  #     if !isValidObject(target): return options.default (here undefined) (target unreachable: caller guards)
  #     if typeof path === 'number': path = String(path)
  #     isArray = Array.isArray(path);  isString = typeof path === 'string'
  #     splitChar = options.separator || '.'    -> '.'
  #     joinChar  = options.joinChar  || '.'    -> '.'
  #     if !isString && !isArray: return target
  #     if isString && (path in target): return target[path]          # NOTE: `in` => own OR inherited
  #     segs = isArray ? path : path.split('.')
  #     len = segs.length; idx = 0
  #     do {
  #       prop = segs[idx]; if typeof prop === 'number': prop = String(prop)
  #       while (prop && prop.slice(-1) === '\\'):
  #            prop = [prop.slice(0,-1), segs[++idx] || ''].join('.')   # escaped-dot reassembly (get-value's)
  #       if (prop in target): target = target[prop]
  #       else:
  #            hasProp=false; n=idx+1
  #            while (n < len): prop = [prop, segs[n++]].join('.'); if (prop in target){target=target[prop]; idx=n-1; hasProp=true; break}
  #            if !hasProp: return options.default (undefined)
  #     } while (++idx < len && isValidObject(target))
  #     return (idx === len) ? target : options.default
  #
  # H5. hasValue(obj, path)      # has-value@2.0.2 top-level
  #     hvIsObject(v) = v != null && (typeof v === 'object' || typeof v === 'function' || Array.isArray(v))
  #     if hvIsObject(obj) && (typeof path === 'string' || Array.isArray(path)):
  #          return hasValues( getValue(obj, path) )
  #     return false
  #     # If `path` is neither string nor array (e.g. number, null, undefined) -> hasValue returns false.
  #
  # H6. isUnsafeKey(key) = (key === '__proto__' || key === 'constructor' || key === 'prototype')
  # H7. validateKey(key): if isUnsafeKey(key) THROW Error(`Cannot set unsafe key: "${key}"`)
  #
  # ---- MAIN PIPELINE: unsetValue(obj, prop) -----------------------------------------------
  #
  # NODE 1 (guard / THROW):
  #     if !isObject(obj):  THROW TypeError('expected an object.')
  #     # Fires for obj that is null, undefined, number, string, boolean, function, or ARRAY.
  #     # (NOTE: this is a THROW, NOT a `return false`. The task hint's "return false" is WRONG;
  #     #  verified by execution against the real package.)
  #
  # NODE 2 (compute isArray):
  #     isArray = Array.isArray(prop)
  #
  # NODE 3 (BRANCH — fast path: own top-level key):
  #     if (!isArray) && obj.hasOwnProperty(prop):
  #         delete obj[prop]
  #         return true
  #     # `hasOwnProperty(prop)` coerces prop to string. Catches a present OWN key even when its
  #     # value is undefined or '' (which hasValue would call "absent"); the fast path wins first.
  #     # Examples: {a:undefined} prop 'a' -> deletes a, returns true.
  #     #           {'a.b':1}     prop 'a.b' (string, dot present as a literal own key) -> deletes, true.
  #     #           {'5':'x'}     prop 5 (number) -> hasOwnProperty('5') true -> deletes, true.
  #     # NOTE: hasOwnProperty checks OWN keys only, so '__proto__'/'constructor'/'prototype' inherited
  #     #       members do NOT trigger this branch; '__proto__' as an OWN data key (via defineProperty)
  #     #       is not codec-faithful. With a normal {} the fast path never deletes an unsafe inherited key.
  #
  # NODE 4 (BRANCH — presence check via has-value):
  #     if hasValue(obj, prop):    # H5 above
  #         # 4a. Build segments:
  #         segs = isArray ? prop.slice() : prop.split('.')
  #         last = segs.pop()
  #         # 4b. Escaped-dot reassembly (unsetValue's OWN version, DIFFERENT from get-value's H4):
  #         while (segs.length && segs[segs.length-1].slice(-1) === '\\'):
  #              last = segs.pop().slice(0,-1) + '.' + last
  #         # IMPORTANT: this only folds a trailing-backslash segment that is IMMEDIATELY before `last`.
  #         #   It does NOT fold a backslash segment separated from `last` by other segments, even though
  #         #   get-value (H4, used by hasValue at NODE 4) DOES fold it. This asymmetry is a real behavior:
  #         #   e.g. obj={'a.b':{c:1}}, prop='a\\.b.c':
  #         #        hasValue -> get-value folds 'a\\'+'.'+'b' = 'a.b', then 'c' -> finds 1 -> hasValue TRUE
  #         #        segs = ['a\\','b','c']; last='c'; segs[-1]='b' (no trailing '\\') -> no fold
  #         #        walk: prop='a\\' -> obj = obj['a\\'] = undefined; prop='b' -> undefined['b']
  #         #        -> THROWS TypeError: Cannot read properties of undefined (reading 'b')
  #         #   But obj={'a.':1}, prop='a\\.':  segs=['a\\'], last=''; segs[-1]='a\\' ends '\\' ->
  #         #        last = 'a\\'.slice(0,-1)+'.'+'' = 'a.'; segs now [] -> delete obj['a.'] -> true.   <-- works
  #         # 4c. SLICE check on segments (array-path hazard):
  #         #   In 4b, segs[last].slice(-1) calls String.prototype.slice. If an array `prop` contains a
  #         #   NON-string segment (e.g. a number), .slice is not a function -> THROWS
  #         #   TypeError: segs[(segs.length - 1)].slice is not a function.
  #         #   e.g. prop=['a',0,'c'] with obj={a:{'0':{c:1}}} -> hasValue true -> .slice(-1) on 0 -> THROW.
  #         #   (String segments like '0' are fine: ['a','0','c'] works.)
  #         # 4d. Walk to parent, validating each intermediate key:
  #         while (segs.length):
  #              prop = segs.shift()
  #              validateKey(prop)       # H7 -> THROWS Error('Cannot set unsafe key: "<prop>"')
  #                                      #   if an INTERMEDIATE key is __proto__/constructor/prototype.
  #                                      #   e.g. {a:{constructor:{x:1}}} prop 'a.constructor.x'
  #                                      #        -> hasValue true -> walk: 'a' ok, 'constructor' -> THROW.
  #              obj = obj[prop]
  #         # 4e. Delete the last key and RETURN its delete result:
  #         return (delete obj[last])
  #         # `delete` returns true normally; returns false only for a non-configurable own property,
  #         # and THROWS TypeError in strict mode for a non-configurable property. Both require
  #         # Object.defineProperty -> NOT codec-faithful -> OUT-OF-ENVELOPE (see SCOPE).
  #
  # NODE 5 (FALLTHROUGH):
  #     return true
  #     # Reached when isObject(obj) AND NODE 3 did not match AND hasValue(obj,prop) is FALSE.
  #     # This returns TRUE WITHOUT DELETING ANYTHING and WITHOUT mutating obj. This is the
  #     # surprising-but-real contract: a "no such present value" call still returns true.
  #     # Examples (all -> ret true, obj UNCHANGED):
  #     #   missing path     : {a:{b:1}}        prop 'a.x.y'   -> true, unchanged
  #     #   missing key      : {a:1}            prop 'z'       -> true, unchanged
  #     #   empty string val : {a:{b:{c:''}}}   prop 'a.b.c'   -> true, unchanged (hasValues('')=false)
  #     #   empty obj val    : {a:{b:{c:{}}}}   prop 'a.b.c'   -> true, unchanged (hasValues({})=false)
  #     #   empty arr val    : {a:{b:[]}}       prop 'a.b'     -> true, unchanged
  #     #   empty string prop: {a:1}            prop ''        -> true, unchanged (hasValue: '' in obj? no)
  #     #   empty array prop : {a:1}            prop []        -> true, unchanged
  #     #   null/undef prop  : {a:1}            prop null|undef-> true, unchanged (hasValue false; not array)
  #     #   prop number miss : {a:1}            prop 7         -> true, unchanged
  #
  # ---- SUMMARY OF RETURN/THROW OUTCOMES (codec-faithful envelope) --------------------------
  #   THROW TypeError 'expected an object.'                : obj not a plain object (NODE 1)
  #   return true (key deleted)                            : NODE 3 fast path, or NODE 4 successful delete
  #   return true (NOTHING deleted, obj unchanged)         : NODE 5 fallthrough
  #   THROW TypeError 'Cannot read properties of undefined': NODE 4 escaped-dot walk dead-ends (4b/4d)
  #   THROW TypeError '...slice is not a function'         : NODE 4 array path with a non-string segment (4c)
  #   THROW Error 'Cannot set unsafe key: "<k>"'           : NODE 4 intermediate key is unsafe (4d/H7)

ORACLE value -> oracle.json
  # The unit MUTATES `obj`, so the observable MUST include the post-state. The harness/driver
  # invokes the unit on a FRESH DEEP-CLONE of the tuple's obj and records:
  #     observable = { ret: <boolean return value>, obj: <JSON.stringify(obj) AFTER the call> }
  #   On a thrown error, record instead:
  #     observable = { __throw: { name: <error.constructor.name>, message: <error.message> } }
  #   (The generator deep-clones each tuple so every emitter run gets an independent obj; no
  #    cross-run contamination. `JSON.stringify(obj)` is the canonical post-state serialization;
  #    key order is insertion order which `delete` preserves for surviving keys.)

SCOPE
  # IN-CONTRACT LOGIC (reproduce exactly — all inlined, no require):
  #   - The 5-node main pipeline above (guard-throw, fast own-key path, has-value path with
  #     escaped-dot reassembly + unsafe-key validation + delete-result return, fallthrough-true).
  #   - The folded helpers H1..H7 (isObject, kindOf-subset, hasValues, getValue, hasValue,
  #     isUnsafeKey, validateKey) exactly as specified.
  #
  # CARRIED DATA: NONE. No large literal tables. (Do not write a carried.json.)
  #
  # DEMONSTRATED IN-SCOPE SUBSET (self-consistent with genInputs — every value the generator can
  # emit has its behavior pinned above and is covered here; verified by 20000-case fuzz, 0 mismatch):
  #   obj kinds emitted : plain nested objects with values drawn from
  #                       { number(incl 0), '' , 'x'/strings, true/false, null, {}, [], [1,2],
  #                         nested objects }  -> all JSON-round-trippable.
  #   prop kinds emitted: dotted strings ('a','a.b','a.b.c'), array paths (['a','b','c'] all-STRING
  #                       segments, incl. ['a','0','c']), single keys, literal-dot keys, escaped-dot
  #                       props ('a\\.b' and 'a\\.'), empty string '', empty array [], number props,
  #                       null, undefined, and the curated throw triggers:
  #                         * non-object obj (number/string/null/undefined/boolean/array) -> TypeError guard
  #                         * array path with a NUMBER segment (['a',0,'c'])               -> slice TypeError
  #                         * escaped-dot mid-path ('a\\.b.c' on {'a.b':{c:1}})            -> read-undefined TypeError
  #                         * unsafe intermediate key ('a.constructor.x' on {a:{constructor:{x:1}}}) -> unsafe-key Error
  #
  # OUT-OF-CONTRACT / OUT-OF-ENVELOPE (NOT emitted by genInputs; documented so a blind engineer
  # still reconstructs them from the spec, but they are not graded because they are not codec-faithful):
  #   - obj/values containing functions, Symbols, undefined as object/array values, NaN/Infinity,
  #     boxed primitives, circular refs: not JSON-round-trippable -> excluded from tuples.
  #   - Non-configurable own properties (Object.defineProperty): make `delete obj[last]` return false
  #     or throw in strict mode (NODE 4e). Requires defineProperty -> not codec-faithful -> excluded.
  #   - '__proto__' / 'constructor' / 'prototype' as an OWN top-level data key (would need defineProperty
  #     to be a real own enumerable key without polluting the prototype) -> excluded. As an INTERMEDIATE
  #     path segment they ARE in-scope and exercised (unsafe-key Error path).
  #   - Map/Set/Date/RegExp/Buffer leaf values affect hasValues (H3) but are excluded from generated
  #     tuples to keep JSON.stringify canonical; their hasValues mapping is fully specified in H3 for
  #     a blind reconstruction.

PROVENANCE
