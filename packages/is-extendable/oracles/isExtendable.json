    {
      "name": "v10",
      "args": [
        [
          []
        ]
      ],
      "expected": true
    },
    {
      "name": "v11",
      "args": [
        [
          {
            "a": 1
          }
        ]
      ],
      "expected": true
    },
    {
      "name": "v12",
      "args": [
        [
          null,
          0,
          ""
        ]
      ],
      "expected": true
    },
    {
      "name": "v13",
      "args": [
        null
      ],
      "expected": false
    },
    {
      "name": "v14",
      "args": [
        0
      ],
      "expected": false
