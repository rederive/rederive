UNIT trimStart
KIND FUNCTIONAL
ORACLE-CLASS deterministic

# Pure string utility. No clock/RNG/env/fs/net seam. No carried data
# (the only literals are small inline regexes, transcribed verbatim below).

SIG trimStart(string = '', chars = <whitespace>, guard?) -> string
    # Public arity is (string, chars). `guard` is a private 3rd parameter the
    # author uses to make trimStart usable as an iteratee (e.g. _.map(arr, _.trimStart)).
    # The DEFAULT EXPORT of the module IS this function: module.exports = trimStart.

DEPENDS-ON none
    # Self-contained: all helpers (toString, baseToString, stringToArray,
    # hasUnicode, asciiToArray, unicodeToArray, charsStartIndex, baseIndexOf,
    # baseFindIndex, castSlice, baseSlice, isSymbol, isObjectLike) are inlined in
    # the source file and reproduced as in-contract logic below. Zero npm deps.

# =====================================================================
# EMISSION CONTRACT (for the blind re-emitter)
# =====================================================================
# The re-emitted module is loaded with dynamic import(). Because the unit is the
# module's DEFAULT export, the re-emitter MUST expose the function as the default:
#     export default function trimStart(string, chars, guard) { ... }
# (NOT a named export). The oracle calls the module's default export with the
# argument tuple. The function must accept up to 3 positional args.

# =====================================================================
# EXACT CONSTANTS (transcribe verbatim — these ARE the contract)
# =====================================================================
CONST reTrimStart = /^\s+/
    # JS-native \s. This is the ECMAScript WhiteSpace + LineTerminator set.
    # VERIFIED to TRIM (when leading) each of these code points:
    #   U+0009 U+000A U+000B U+000C U+000D U+0020 U+00A0 U+1680
    #   U+2000..U+200A U+2028 U+2029 U+202F U+205F U+3000 U+FEFF
    # VERIFIED to NOT trim U+200B (ZERO WIDTH SPACE is not in JS \s).
    # Use the platform's native /^\s+/ semantics; do not hand-roll the set.

# Inline unicode regex source fragments (used to build reUnicode / reHasUnicode).
# Reproduce these EXACT strings, then build the two regexes from them:
CONST rsAstralRange       = '\ud800-\udfff'
CONST rsComboMarksRange   = '̀-ͯ︠-︣'
CONST rsComboSymbolsRange = '⃐-⃰'
CONST rsVarRange          = '︎️'
CONST rsAstral    = '[' + rsAstralRange + ']'
CONST rsCombo     = '[' + rsComboMarksRange + rsComboSymbolsRange + ']'
CONST rsFitz      = '\ud83c[\udffb-\udfff]'
CONST rsModifier  = '(?:' + rsCombo + '|' + rsFitz + ')'
CONST rsNonAstral = '[^' + rsAstralRange + ']'
CONST rsRegional  = '(?:\ud83c[\udde6-\uddff]){2}'
CONST rsSurrPair  = '[\ud800-\udbff][\udc00-\udfff]'
CONST rsZWJ       = '‍'
CONST reOptMod    = rsModifier + '?'
CONST rsOptVar    = '[' + rsVarRange + ']?'
CONST rsOptJoin   = '(?:' + rsZWJ + '(?:' + [rsNonAstral, rsRegional, rsSurrPair].join('|') + ')' + rsOptVar + reOptMod + ')*'
CONST rsSeq       = rsOptVar + reOptMod + rsOptJoin
CONST rsSymbol    = '(?:' + [rsNonAstral + rsCombo + '?', rsCombo, rsRegional, rsSurrPair, rsAstral].join('|') + ')'
CONST reUnicode    = RegExp(rsFitz + '(?=' + rsFitz + ')|' + rsSymbol + rsSeq, 'g')
CONST reHasUnicode = RegExp('[' + rsZWJ + rsAstralRange + rsComboMarksRange + rsComboSymbolsRange + rsVarRange + ']')
    # reHasUnicode (no /g): matches if the string contains ANY of:
    #   ZWJ (U+200D), an astral surrogate-range unit (U+D800..U+DFFF),
    #   a combining mark (U+0300..U+036F, U+FE20..U+FE23, U+20D0..U+20F0),
    #   or a variation selector (U+FE0E, U+FE0F).
    # VERIFIED false for plain ASCII, for precomposed accents (e.g. U+00E9 'é'),
    # for NBSP/BOM/ZWSP. VERIFIED true for any string holding e+combining-acute,
    # any astral emoji, any regional indicator, any ZWJ sequence.

# =====================================================================
# BEHAVIOR  (ordered pipeline — exact)
# =====================================================================
# trimStart(string, chars, guard):
#
# NODE 1 — coerce `string` via toString(string):
#   toString(value):
#     if value is null OR undefined  -> return ''
#     else return baseToString(value)
#   baseToString(value):
#     if typeof value == 'string'    -> return value unchanged
#     if isSymbol(value)             -> OUT-OF-ENVELOPE (see SCOPE; not generated)
#     result = (value + '')          # JS default string coercion
#     if result == '0' AND (1 / value) == -Infinity  -> return '-0'   # the -0 special-case
#     else return result
#   isSymbol(value): typeof value=='symbol' OR (objectLike(value) AND
#                    Object.prototype.toString.call(value)=='[object Symbol]')
#   VERIFIED coercions:
#     -0 -> '-0'      0 -> '0'        123 -> '123'      true -> 'true'   false -> 'false'
#     Infinity -> 'Infinity'   -Infinity -> '-Infinity'   NaN -> 'NaN'
#     null -> ''      undefined -> ''   10n (bigint) -> '10'
#     [1,2,3] -> '1,2,3'        {a:1} -> '[object Object]'
#   After this node, `string` is a primitive JS string.
#
# NODE 2 — WHITESPACE BRANCH (the guard / default path):
#     if string (non-empty, i.e. truthy) AND (guard is truthy OR chars === undefined):
#         return string.replace(reTrimStart, '')      # strip leading /^\s+/
#   Two important sub-rules, BOTH VERIFIED:
#     (a) `guard` truthy (e.g. {} , 5 , [1] , 'g') FORCES this branch and IGNORES `chars`.
#         t('xxabc','x',{}) -> 'xxabc'   (no leading whitespace; x is not \s)
#         t('  abc','x',{}) -> 'abc'     (leading whitespace stripped; chars ignored)
#         t('xxabc','x',5)  -> 'xxabc'   (numeric truthy guard, same)
#     (b) `guard` FALSY (0, '', null, NaN, false; or absent/undefined) does NOT force
#         this branch via the guard term; falls through to the chars branch using `chars`
#         (unless chars is ALSO undefined, in which case the `chars === undefined`
#         disjunct still selects this branch).
#         t('xxabc','x',0) -> 'abc'      (custom branch active)
#     The guard expression is `guard || chars === undefined`, so when guard is
#     falsy AND chars is undefined, this branch still runs (whitespace trim).
#         t('  abc')            -> 'abc'   (chars omitted -> chars === undefined)
#         t('  abc', undefined) -> 'abc'   (same; explicit undefined chars)
#     Note `string` must be truthy to enter: empty string '' is falsy and skips
#     this branch (handled by NODE 3 -> returns '').
#
# NODE 3 — EARLY-OUT when nothing to do:
#     if (!string) OR (!(chars = baseToString(chars))):
#         return string
#   i.e. reassign chars := baseToString(chars) and:
#     - if string is '' (empty/falsy) -> return string ('')
#     - if the COERCED chars is empty/falsy ('') -> return string unchanged
#   baseToString(chars) is used here (NOT toString): baseToString(undefined)
#   would yield 'undefined' and baseToString(null) 'null' — but a truthy string
#   with undefined chars already returned in NODE 2 (chars===undefined disjunct),
#   and an empty string already returns here via !string. So `chars` reaching the
#   coercion is whatever caller passed (possibly null, a number, etc.).
#   VERIFIED chars coercions entering the set:
#     null -> 'null'   false -> 'false'   0 -> '0'   -0 -> '-0'   NaN -> 'NaN'
#     Infinity -> 'Infinity'   '' -> '' (falsy -> early return, string unchanged)
#   VERIFIED:
#     t('', 'x')      -> ''      (string falsy)
#     t('  abc', '')  -> '  abc' (chars coerces to '' -> unchanged, leading ws kept!)
#     t('xyz', null)  -> 'xyz'   (chars='null'; 'x' not in {n,u,l}; unchanged)
#     t('nullnX','null') -> 'X'  (set {n,u,l}; strips leading n,u,l,l,n)
#
# NODE 4 — CUSTOM-CHARS BRANCH (chars is a non-empty coerced string):
#     strSymbols = stringToArray(string)
#     chrSymbols = stringToArray(chars)
#     start      = charsStartIndex(strSymbols, chrSymbols)
#     return castSlice(strSymbols, start).join('')
#
#   stringToArray(s):
#       if hasUnicode(s)  -> unicodeToArray(s) = (s.match(reUnicode) || [])
#       else              -> asciiToArray(s)   = s.split('')      # one JS char unit per element
#     hasUnicode(s) = reHasUnicode.test(s)   (see CONST above)
#     SYMBOL GROUPING under unicodeToArray (VERIFIED, faithful examples; each
#     bracket is one array element / one "symbol"):
#       'e' + U+0301              -> ['é']        (base + combining = 1 symbol)
#       U+0301 + U+0301 + 'abc'   -> ['́́','a','b','c']  (2 leading combinings GROUP into 1 symbol)
#       U+1F600 U+1F600 'abc'     -> ['\u{1F600}','\u{1F600}','a','b','c']  (each astral emoji = 1 symbol)
#       man+ZWJ+woman+ZWJ+girl    -> ['\u{1F468}‍\u{1F469}‍\u{1F467}']  (whole ZWJ sequence = 1 symbol)
#       U+1F1FA U+1F1F8 (US flag) -> ['\u{1F1FA}\u{1F1F8}']  (2 regional indicators = 1 symbol)
#       'e' + U+FE0F (var sel)    -> ['e️']         (base + variation selector = 1 symbol)
#     IMPORTANT: membership is by EXACT SYMBOL STRING equality (===), not by code point.
#       The chars set = the multiset of symbols produced by stringToArray(chars).
#       A leading string symbol is removed iff it === some chars symbol.
#       VERIFIED: t('é'+'xyz','é') -> 'xyz'   (symbol 'é' in set)
#                 t('é'+'xyz','é')  -> 'éxyz' (precomposed é NOT === 'é')
#                 t('́́'+'abc','́')        -> '́́abc' (set {'́'}; leading sym is '́́' -> no match)
#                 t('́́'+'abc','́́')  -> 'abc' (set {'́́'}; matches)
#                 t('\u{1F600}\u{1F600}abc','\u{1F600}')  -> 'abc' (emoji symbol matched twice)
#                 t('\u{1F1FA}\u{1F1F8}end','\u{1F1FA}')  -> '\u{1F1FA}\u{1F1F8}end' (single regional != flag symbol)
#
#   charsStartIndex(strSymbols, chrSymbols):
#       index = -1
#       while (++index < strSymbols.length AND baseIndexOf(chrSymbols, strSymbols[index], 0) > -1) {}
#       return index
#     i.e. advance index over the LEADING run of string symbols that are members
#     of the chars set; stop at the first non-member (or end). Returns that index.
#     baseIndexOf(array, value, 0): linear search; value===value always true here
#       (symbols are strings, never NaN) so it is plain `array.indexOf(value)` from 0.
#
#   castSlice(strSymbols, start):    # end defaults to length
#       if (!start && end >= length) return array        # start===0 fast path: whole array
#       else return baseSlice(array, start, length)      # the symbols from `start` onward
#     .join('') reassembles the surviving symbols into the result string.
#     VERIFIED leading-only: t('-_-abc','_-') -> 'abc' ; t('xxabcxx','x') -> 'abcxx'
#       (trailing occurrences are NEVER touched — this is trimSTART).
#     VERIFIED trailing-only / interior whitespace untouched in whitespace branch too:
#       t('abc   ') -> 'abc   ' ; t('  abc  ') -> 'abc  '

ORACLE value -> oracle.json

# =====================================================================
# SCOPE
# =====================================================================
# IN-CONTRACT LOGIC (reproduce exactly): the entire pipeline above —
#   toString/baseToString coercion incl. the -0 special-case; the
#   `string && (guard || chars === undefined)` whitespace-branch gate and the
#   guard-forces-whitespace / guard-ignores-chars rule; the chars early-out via
#   baseToString(chars) falsy; stringToArray (hasUnicode -> reUnicode unicode
#   split vs ASCII char split) with the EXACT symbol grouping; exact-symbol-string
#   set membership; charsStartIndex leading-run scan; castSlice+join.
#   All regexes (reTrimStart, reUnicode, reHasUnicode) are reproduced verbatim
#   from the CONST block. The whitespace set is the platform-native /^\s+/.
#
# CARRIED DATA: none. The only literals are the small inline regex source
#   fragments above, transcribed in full (no large table to extract).
#
# OUT-OF-CONTRACT / OUT-OF-ENVELOPE (NOT emitted by genInputs; a blind
#   re-emitter still reconstructs behavior from the spec):
#   - `string` or `chars` being a Symbol primitive/object: routes through the
#     isSymbol branch of baseToString (symbolToString.call) — not codec-faithful
#     (Symbols do not survive JSON), so not generated. Documented here for fidelity.
#   - `string`/`chars` = a function, or a value whose .toString throws: not
#     codec-faithful / out of envelope; not generated.
#   - A BARE `undefined` AS AN ARG-ARRAY ELEMENT does not survive the harness
#     codec (JSON turns it into null), so the generator never emits one:
#       * the `chars === undefined` whitespace branch is exercised by tuples that
#         OMIT chars (length-1 tuples) — observationally identical;
#       * the `string === undefined -> ''` default is covered observationally by
#         `[null]` (also -> ''); both pinned in NODE 1.
#     A blind re-emitter still reproduces the undefined paths from this spec.
#   - NaN / ±Infinity / -0 AS AN ARG round-trip through the harness codec (per the
#     task's codec list) and ARE generated; their coercions are pinned above
#     (-0 -> '-0', etc.; -0 specifically exercises the -0 special-case).
#   No side effects, no ambient reads, no throws on any in-envelope input.

PROVENANCE lodash.trimstart@4.5.1 ; repo lodash/lodash (modularized build,
  exports="npm") ; MIT license (Copyright jQuery Foundation / OpenJS) ;
  source file index.js (single file, default export `module.exports = trimStart`).
