{
  "mode": "vectors",
  "exportName": null,
  "unit": "unsetValue",
  "vectors": [
    {
      "name": "v0",
      "args": [
        {
          "a": 1,
          "b": 2
        },
        "a"
      ],
      "expected": true
    },
    {
      "name": "v1",
      "args": [
        {
          "a": {
            "b": {
              "c": 1,
              "d": 2
            }
          }
        },
        "a.b.c"
      ],
      "expected": true
    },
    {
      "name": "v2",
      "args": [
        {
          "a": {
            "b": {
              "c": 1,
              "d": 2
            }
          }
        },
        [
          "a",
          "b",
          "c"
        ]
      ],
      "expected": true
    },
    {
      "name": "v3",
      "args": [
        {
          "a": {
            "0": {
              "c": 1,
              "d": 2
            }
          }
        },
        [
          "a",
          "0",
          "c"
        ]
      ],
      "expected": true
    },
    {
      "name": "v4",
      "args": [
        {
          "a": {
            "b": 1,
            "c": 2
          }
        },
        "a.b"
      ],
      "expected": true
    },
    {
      "name": "v5",
      "args": [
        {
          "a": 1,
          "b": 2
        },
        [
          "a"
        ]
      ],
      "expected": true
    },
    {
      "name": "v6",
      "args": [
        {
          "a": 1
        },
        [
          "z"
        ]
      ],
      "expected": true
    },
    {
      "name": "v7",
      "args": [
        {
          "a": {
            "b": 1
          }
        },
        "a.x.y"
      ],
      "expected": true
    },
    {
      "name": "v8",
      "args": [
        {
          "a": 1
        },
        "z"
      ],
      "expected": true
    },
    {
      "name": "v9",
      "args": [
        {
          "a": {
            "b": {
              "c": ""
            }
          }
        },
        "a.b.c"
      ],
      "expected": true
    },
    {
      "name": "v10",
      "args": [
        {
          "a": {
            "b": {
              "c": {}
            }
          }
        },
        "a.b.c"
      ],
      "expected": true
    },
    {
      "name": "v11",
      "args": [
        {
          "a": {
            "b": []
          }
        },
        "a.b"
      ],
      "expected": true
    },
    {
      "name": "v12",
      "args": [
        {
          "a": {
            "b": {
              "x": "",
              "y": {}
            }
          }
        },
        "a.b"
      ],
      "expected": true
    },
    {
      "name": "v13",
      "args": [
        {
          "a": {
            "b": [
              1,
              2
            ]
          }
        },
        "a.b"
      ],
      "expected": true
    },
    {
      "name": "v14",
      "args": [
        {
          "a": {
            "b": {
              "c": 0
            }
          }
        },
        "a.b.c"
      ],
      "expected": true
    },
    {
      "name": "v15",
      "args": [
        {
          "a": {
            "b": false
          }
        },
        "a.b"
      ],
      "expected": true
    }
  ],
  "heldout": [
    {
      "name": "bal0",
      "args": [
        3.14,
        "a"
      ],
      "expected": {
        "__throw": "expected an object."
      }
    },
    {
      "name": "bal1",
      "args": [
        {
          "a": {
            "b": {
              "c": null
            }
          }
        },
        "a.b.c"
      ],
      "expected": true
    },
    {
      "name": "bal2",
      "args": [
        [
          1,
          2,
          3
        ],
        "a"
      ],
      "expected": {
        "__throw": "expected an object."
      }
    },
    {
      "name": "bal3",
      "args": [
        {
          "a": ""
        },
        "a"
      ],
      "expected": true
    },
    {
      "name": "bal4",
      "args": [
        {
          "__t": "undef"
        },
        "a"
      ],
      "expected": {
        "__throw": "expected an object."
      }
    },
    {
      "name": "bal5",
      "args": [
        {
          "a": 0
        },
        "a"
      ],
      "expected": true
    },
    {
      "name": "bal6",
      "args": [
        {
          "a": {
            "constructor": {
              "x": 1
            }
          }
        },
        "a.constructor.x"
      ],
      "expected": {
        "__throw": "Cannot set unsafe key: \"constructor\""
      }
    },
    {
      "name": "bal7",
      "args": [
        {},
        "a"
      ],
      "expected": true
    },
    {
      "name": "bal8",
      "args": [
        {
          "a.b": {
            "c": 1
          }
        },
        "a\\.b.c"
      ],
      "expected": {
        "__throw": "Cannot read properties of undefined (reading 'b')"
      }
    },
    {
      "name": "bal9",
      "args": [
        {
          "a": {
            "0": {
              "c": 1
            }
          }
        },
        [
          "a",
          0,
          "c"
        ]
      ],
      "expected": {
        "__throw": "segs[(segs.length - 1)].slice is not a function"
      }
    },
    {
      "name": "bal10",
      "args": [
        {
          "__t": "num",
          "v": "NaN"
        },
        "a"
      ],
      "expected": {
        "__throw": "expected an object."
      }
    },
    {
      "name": "bal11",
      "args": [
        {
          "__t": "bigint",
          "v": "5"
        },
        "a"
      ],
      "expected": {
        "__throw": "expected an object."
      }
    }
  ]
}
