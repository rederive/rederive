{
  "mode": "vectors",
  "exportName": "isPlainObject",
  "unit": "isPlainObject",
  "vectors": [
    {
      "name": "v0",
      "args": [
        {}
      ],
      "expected": true
    },
    {
      "name": "v1",
      "args": [
        {
          "a": 1
        }
      ],
      "expected": true
    },
    {
      "name": "v2",
      "args": [
        {
          "a": 1,
          "b": 2,
          "c": 3
        }
      ],
      "expected": true
    },
    {
      "name": "v3",
      "args": [
        {
          "a": {
            "b": 1
          }
        }
      ],
      "expected": true
    },
    {
      "name": "v4",
      "args": [
        {
          "x": [
            1,
            2,
            {
              "y": 3
            }
          ]
        }
      ],
      "expected": true
    },
    {
      "name": "v5",
      "args": [
        {
          "0": "z",
          "": 0,
          "key with space": true
        }
      ],
      "expected": true
    },
    {
      "name": "v6",
      "args": [
        {
          "0": "a",
          "1": "b",
          "length": 3
        }
      ],
      "expected": true
    },
    {
      "name": "v7",
      "args": [
        []
      ],
      "expected": false
    },
    {
      "name": "v8",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": false
    },
    {
      "name": "v9",
      "args": [
        [
          {
            "a": 1
          },
          {
            "b": 2
          }
        ]
      ],
      "expected": false
    },
    {
      "name": "v10",
      "args": [
        null
      ],
      "expected": false
    },
    {
      "name": "v11",
      "args": [
        {
          "__t": "undef"
        }
      ],
      "expected": false
    },
    {
      "name": "v12",
      "args": [
        0
      ],
      "expected": false
    },
    {
      "name": "v13",
      "args": [
        42
      ],
      "expected": false
    },
    {
      "name": "v14",
      "args": [
        -7.5
      ],
      "expected": false
    },
    {
      "name": "v15",
      "args": [
        {
          "__t": "num",
          "v": "-0"
        }
      ],
      "expected": false
    }
  ],
  "heldout": [
    {
      "name": "bal0",
      "args": [
        {
          "q": 7,
          "w": 8,
          "constructor": {
            "__t": "undef"
          }
        }
      ],
      "expected": true
    },
    {
      "name": "bal1",
      "args": [
        {
          "__t": "num",
          "v": "NaN"
        }
      ],
      "expected": false
    },
    {
      "name": "bal2",
      "args": [
        {
          "constructor": null
        }
      ],
      "expected": {
        "__throw": "Cannot read properties of null (reading 'prototype')"
      }
    },
    {
      "name": "bal3",
      "args": [
        {
          "constructor": {
            "prototype": {
              "isPrototypeOf": 42,
              "extra": 1
            }
          }
        }
      ],
      "expected": true
    },
    {
      "name": "bal4",
      "args": [
        {
          "__t": "num",
          "v": "Infinity"
        }
      ],
      "expected": false
    },
    {
      "name": "bal5",
      "args": [
        {
          "constructor": {
            "prototype": {
              "isPrototypeOf": {
                "__t": "undef"
              },
              "more": true
            }
          }
        }
      ],
      "expected": true
    },
    {
      "name": "bal6",
      "args": [
        {
          "__t": "num",
          "v": "-Infinity"
        }
      ],
      "expected": false
    },
    {
      "name": "bal7",
      "args": [
        {
          "hasOwnProperty": 1,
          "toString": 2,
          "isPrototypeOf": 3
        }
      ],
      "expected": true
    },
    {
      "name": "bal8",
      "args": [
        ""
      ],
      "expected": false
    },
    {
      "name": "bal9",
      "args": [
        {
          "🔑": {
            "ok": true
          },
          "ключ": [
            1,
            2,
            3
          ],
          "": 0
        }
      ],
      "expected": true
    },
    {
      "name": "bal10",
      "args": [
        {
          "123": "numeric-string-key",
          "a-b.c": 1,
          " ": "space",
          "protoKey": 7
        }
      ],
      "expected": true
    },
    {
      "name": "bal11",
      "args": [
        "hello"
      ],
      "expected": false
    }
  ]
}
