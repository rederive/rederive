    is-number@3.0.0  (jonschlinkert/is-number, MIT)     is-number/index.js
    kind-of@3.2.2    (jonschlinkert/kind-of, MIT)       kind-of/index.js
    is-buffer@1.1.6  (feross/is-buffer, MIT)            is-buffer/index.js
