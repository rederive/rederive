UNIT gte
KIND FUNCTIONAL
ORACLE-CLASS deterministic
SIG gte(value: any, other: any) -> boolean
DEPENDS-ON none   # self-contained; inlines toNumber + isObject + isObjectLike + isSymbol from the lodash build

# ============================================================================
# PROVENANCE
# ============================================================================
PROVENANCE
  package: lodash.gte@3.9.2  (npm)
  repo:    lodash/lodash   (modularized build: `lodash modularize exports="npm" -o ./`)
  license: MIT
  source:  node_modules/lodash.gte/index.js
  export:  module.exports = gte   (DEFAULT export)
  NOTE: despite the package.json "version": "3.9.2", the bundled source is the
