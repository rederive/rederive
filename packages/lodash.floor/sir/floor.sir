UNIT floor
KIND FUNCTIONAL
ORACLE-CLASS deterministic
SIG floor(number: any, precision?: any = 0) -> number
# Default export of the npm package. The blind emitter MUST emit it as: export default <fn>
DEPENDS-ON none   # zero runtime deps; all helpers (toNumber/toInteger/toFinite/toString) are inlined below

# ===========================================================================
# PURPOSE
#   Computes `number` rounded DOWN (toward -Infinity) to `precision` decimal
#   places. Built by createRound('floor'): the generic round factory wired to
#   Math.floor. (Sibling _.ceil/_.round differ ONLY in the Math method used.)
#   `_.floor(4.006)    -> 4`
#   `_.floor(0.046, 2) -> 0.04`
#   `_.floor(4060, -2) -> 4000`
# ===========================================================================

# ---------------------------------------------------------------------------
# CONSTANTS (exact, from source)
# ---------------------------------------------------------------------------
#   INFINITY    = 1 / 0                          # +Infinity
#   MAX_INTEGER = 1.7976931348623157e+308        # Number.MAX_VALUE
#   NAN         = 0 / 0                           # NaN
#   reTrim      = /^\s+|\s+$/g                    # leading/trailing whitespace
#   reIsBadHex  = /^[-+]0x[0-9a-f]+$/i            # signed hex strings (rejected -> NaN)
#   reIsBinary  = /^0b[01]+$/i                    # binary string literal
#   reIsOctal   = /^0o[0-7]+$/i                   # octal string literal
#   symbolTag   = '[object Symbol]'
#   nativeMin   = Math.min
#   freeParseInt= parseInt
#   PRECISION_CAP = 292                           # the ONLY clamp (upper bound)

# ===========================================================================
# BEHAVIOR  (the createRound('floor') closure, exact ordered pipeline)
# ===========================================================================
#
# floor(number, precision):
#   1. number    = toNumber(number)                      # coerce value -> JS number
#   2. precision  = nativeMin(toInteger(precision), 292)  # integer-coerce, UPPER-clamp at 292
#                                                          # *** NO lower clamp ***  (see NODE-CLAMP)
#   3. BRANCH on truthiness of precision (JS `if (precision)`):
#
#      NODE-A  precision is FALSY  (precision === 0  OR  precision is NaN):
#              return Math.floor(number)
#              # NaN precision is falsy -> hits this branch, so floor(123.456, NaN) == Math.floor(123.456) == 123
#              # precision 0 (and any value toInteger->0) -> direct Math.floor
#
#      NODE-B  precision is TRUTHY (any nonzero finite integer, positive or negative):
#              # exp-shift trick to dodge binary-float error (per MDN round examples)
#              pair  = (toString(number) + 'e').split('e')          # [mantissaStr, expStr]
#              value = Math.floor( pair[0] + 'e' + (+pair[1] + precision) )   # shift UP, floor
#              pair  = (toString(value)  + 'e').split('e')          # re-split the floored value
#              return +( pair[0] + 'e' + (+pair[1] - precision) )   # shift back DOWN, return Number
#
#   EXP-SHIFT MECHANICS (trace floor(0.046, 2)):
#     toString(0.046)='0.046'; ('0.046'+'e').split('e') = ['0.046','']
#       +pair[1] = +'' = 0;  0 + 2 = 2
#       value = Math.floor('0.046'+'e'+2) = Math.floor('0.046e2') = Math.floor(4.6) = 4
#     toString(4)='4'; ('4'+'e').split('e') = ['4','']
#       +pair[1] = 0;  0 - 2 = -2
#       return +('4'+'e'+(-2)) = +('4e-2') = 0.04
#   Trace floor(4060, -2):
#     ['4060',''] -> +''+(-2) = -2 -> Math.floor('4060e-2')=Math.floor(40.6)=40
#     ['40',''] -> 0 - (-2) = 2 -> +('40e2') = 4000
#   Trace floor(-0.046, 2):  Math.floor(-4.6) = -5 -> +('-5e-2') = -0.05   (rounds toward -Inf)
#
#   E-NOTATION RE-SPLIT: when toString(number) or toString(value) is already in
#   exponential form, the split('e') captures the existing exponent. E.g.
#   toString(1.55e21)='1.55e+21' -> pair=['1.55','+21'], +'+21'=21. The two shifts
#   (+precision then -precision) cancel net, so very-large/very-small magnitudes
#   round back to themselves when the shift doesn't change the floored mantissa
#   (floor(1.55e21, 1) -> 1.55e+21; floor(1.55e21, -19) -> 1.55e+21).
#
#   OVERFLOW -> NaN: if shifting UP pushes the mantissa-string beyond ~1.8e308,
#   Math.floor(<overflowed string>) = Math.floor(Infinity) = Infinity, then the
#   shift-back yields +('Infinity-stuff') chain that produces NaN. Empirically:
#     floor(9e305, 2) -> 9e+305   (no overflow)
#     floor(9e306, 2) -> NaN      (overflow on +2 shift)
#     floor(1.7976931348623157e+308, 2) -> NaN
#   The emitter does NOT special-case this; it falls out of the exact string-shift arithmetic.

# ---------------------------------------------------------------------------
# NODE-CLAMP  (CRITICAL — overrides any "clamp [-292,292]" claim)
#   precision = nativeMin(toInteger(precision), 292).
#   This is ONLY an UPPER clamp. There is NO lower (-292) clamp in the source.
#   Negative precision is NOT bounded below by toInteger; it is bounded below
#   only by toInteger's own range (toFinite caps |Infinity| at MAX_INTEGER):
#     - precision > 292            -> 292            (e.g. 293, 1e9, Infinity)
#     - precision == +Infinity     -> toInteger=+MAX_INTEGER -> nativeMin(.,292)=292
#     - precision == -Infinity     -> toInteger=-MAX_INTEGER -> nativeMin(.,292)=-MAX_INTEGER
#                                     (a huge negative TRUTHY precision -> NODE-B -> typically NaN
#                                      via the overflowing string shift: floor(123.456,-Infinity)->NaN)
#     - precision == NaN           -> toInteger=0  (toFinite(NaN)=0)  -> FALSY -> NODE-A
#     - fractional precision       -> toInteger truncates toward 0 (2.9->2, -2.9->-2)
# ---------------------------------------------------------------------------

# ===========================================================================
# HELPER SEMANTICS (inline these EXACTLY — they govern coercion of both args)
# ===========================================================================
#
# toNumber(value):   # used on `number`
#   - typeof 'number'            -> value (as-is, incl. NaN, +/-Infinity, -0)
#   - isSymbol(value)            -> NaN          # OUT-OF-ENVELOPE (Symbols not codec-emitted)
#   - isObject(value)            -> other = value.valueOf?() else value;
#                                   if other still object -> (other + '') else other; then continue
#   - if typeof != 'string'      -> (value === 0 ? value : +value)   # preserves -0; coerces bool/etc
#   - else (string):
#       v = value.replace(/^\s+|\s+$/g,'')        # trim
#       isBinary = /^0b[01]+$/i.test(v)
#       if isBinary or /^0o[0-7]+$/i.test(v):
#            return freeParseInt(v.slice(2), isBinary ? 2 : 8)     # "0b101"->5, "0o17"->15
#       else if /^[-+]0x[0-9a-f]+$/i.test(v):
#            return NaN                                            # bad signed hex: "-0x1f"->NaN
#       else return +v        # unary-plus coercion: "3.14"->3.14, "1e2"->100, "0x1f"->31,
#                             #   ""->0, "   "->0(after trim), "abc"->NaN
#   STRING NUMERIC EXAMPLES (all confirmed against package):
#     "3.14"->3.14  "1e2"->100  "  3.14  "->3.14  "0x1f"->31  "0b101"->5  "0o17"->15
#     "-0x1f"->NaN  "abc"->NaN  ""->0  "   "->0
#
# toFinite(value):
#   - if !value: return value===0 ? value : 0     # 0 and -0 pass through as-is; NaN/''/null/undefined/false -> 0
#   - value = toNumber(value)
#   - if value === +Infinity or -Infinity: return (value<0?-1:1) * MAX_INTEGER
#   - return value===value ? value : 0            # NaN -> 0
#
# toInteger(value):   # used on `precision`
#   - result = toFinite(value); remainder = result % 1
#   - return result===result ? (remainder ? result - remainder : result) : 0
#   - i.e. truncate toward zero; Infinity->+MAX_INTEGER, -Infinity->-MAX_INTEGER, NaN->0
#   - String precision coerced via toNumber first: "2"->2, "0b10"->2
#
# toString(value):   # used INSIDE the exp-shift (on number and on intermediate value)
#   - value == null (null or undefined) -> ''     # (not reachable for `value`, which is a number here)
#   - baseToString(value):
#       typeof 'string' -> value
#       isSymbol -> symbol's toString (OUT-OF-ENVELOPE)
#       result = (value + '')
#       return (result == '0' && (1/value) == -Infinity) ? '-0' : result   # *** preserves -0 ***
#   - SO: toString(-0) === '-0', preserving sign through the shift. floor(-0, 2) -> -0 (Object.is true);
#         floor(-0, 0) -> Math.floor(-0) -> -0. But floor(0, 2) -> +0 (not -0).
#
# isObject(v):     !!v && (typeof v == 'object' || typeof v == 'function')
# isObjectLike(v): !!v && typeof v == 'object'
# isSymbol(v):     typeof v=='symbol' || (isObjectLike(v) && Object.prototype.toString.call(v)=='[object Symbol]')

# ===========================================================================
# CONFIRMED EDGE TABLE (real package, must reproduce EXACTLY)
# ===========================================================================
#   floor(4.006)                          -> 4
#   floor(4.006, 0)                       -> 4
#   floor(0.046, 2)                       -> 0.04
#   floor(4060, -2)                       -> 4000
#   floor(NaN)                            -> NaN
#   floor(Infinity)                       -> Infinity      # Math.floor(Infinity)
#   floor(-Infinity)                      -> -Infinity
#   floor(-0)                             -> -0            # Object.is(.,-0) === true
#   floor(0)                              -> 0
#   floor(-0, 2)                          -> -0
#   floor(0, 2)                           -> +0            # NOT -0
#   floor(2.5)                            -> 2
#   floor(-2.5)                           -> -3            # floor toward -Inf
#   floor(-0.0001)                        -> -1
#   floor(-0.5, 0)                        -> -1
#   floor(-0.046, 2)                      -> -0.05
#   floor(0.5, -1)                        -> 0             # +0, not -0
#   floor("3.14")                         -> 3
#   floor("1e2")                          -> 100
#   floor("1e2", -1)                      -> 100
#   floor("  3.14  ")                     -> 3
#   floor("0x1f")                         -> 31
#   floor("0b101")                        -> 5
#   floor("0o17")                         -> 15
#   floor("-0x1f")                        -> NaN
#   floor("abc")                          -> NaN
#   floor("")                             -> 0
#   floor(undefined)                      -> NaN           # +undefined = NaN
#   floor(null)                           -> 0             # !value -> 0 in toNumber? actually +null=0
#   floor(0.046, 2.9)                     -> 0.04          # toInteger(2.9)=2
#   floor(0.046, -2.9)                    -> 0             # toInteger(-2.9)=-2
#   floor(0.046, -1)                      -> 0
#   floor(123.456, "2")                   -> 123.45
#   floor(0.046, "0b10")                  -> 0.04          # toInteger("0b10")=2
#   floor(123.456, NaN)                   -> 123           # NaN precision falsy -> Math.floor
#   floor(123.456, Infinity)              -> 123.456       # clamp 292
#   floor(123.456, -Infinity)             -> NaN           # huge negative precision overflow
#   floor(123.456, 293)                   -> 123.456       # clamp 292
#   floor(123.456, 1e9)                   -> 123.456       # clamp 292
#   floor(123.456, -10)                   -> 0
#   floor(549, -2)                        -> 500
#   floor(550, -2)                        -> 500
#   floor(-549, -2)                       -> -600
#   floor(950, -3)                        -> 0
#   floor(1e-7, 9)                        -> 1e-7
#   floor(1.23e-5, 6)                     -> 0.000012
#   floor(5e-324)                         -> 0
#   floor(5e-324, 400)                    -> 0             # precision clamped to 292
#   floor(1.55e21, 1)                     -> 1.55e+21
#   floor(1.55e21, -19)                   -> 1.55e+21
#   floor(9e305, 2)                       -> 9e+305
#   floor(9e306, 2)                       -> NaN           # overflow during +2 shift
#   floor(1.7976931348623157e+308, 2)     -> NaN
#   floor(1.23456789e21, 2)               -> 1.23456789e+21

ORACLE value -> oracle.json
# Pure value function. The harness records each input tuple's exact return
# (with -0 / NaN / +/-Infinity preserved via the codec). No seam; deterministic.

SCOPE
  IN-CONTRACT (reproduce exactly):
    - The entire createRound('floor') exp-shift pipeline (NODE-A / NODE-B above).
    - toNumber / toInteger / toFinite / toString coercions, INCLUDING the -0 string
      special-case and the trim + binary/octal/bad-hex string handling.
    - The single UPPER precision clamp at 292 (NO lower clamp).
    - All entries in the CONFIRMED EDGE TABLE.
  CARRIED-DATA: none.
  OUT-OF-CONTRACT / OUT-OF-ENVELOPE (documented, NOT emitted by genInputs):
    - Symbol inputs: toNumber/toString route through isSymbol -> NaN / symbol.toString.
      Symbols are not oracle-codec round-trippable, so they are NOT generated; behavior
      is documented (number Symbol -> NaN) for completeness only.
    - Function-valued inputs: isObject true; valueOf -> (other+'') string path. Functions
      are not round-trippable; not generated.
    - Object inputs with custom valueOf/toString: in-contract per toNumber, but identity-
      bearing class instances do not round-trip; the generator emits only plain primitives,
      strings, and JSON-faithful values whose behavior the SIR fully specifies above.
    - No side effects, no mutation: floor is pure and read-only. N/A for mutation handling.

PROVENANCE lodash.floor@4.0.4 (MIT). Custom lodash modularized build
  (`lodash modularize exports="npm" -o ./`). Repo: lodash/lodash.
  Source file: node_modules/lodash.floor/index.js (single file, zero deps).
  Default export: module.exports = createRound('floor').
