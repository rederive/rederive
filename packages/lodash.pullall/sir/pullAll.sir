#             1.8.3 lineage)
#   file:     index.js  (213-line file; arrayProto/splice at lines 124/127;
#             basePullAll at lines 140-165; copyArray at 175-184; baseIndexOf at
#             62-75; baseFindIndex at 41-51; baseIsNaN at 106-108; pullAll at
#             206-210; module.exports at 212)
