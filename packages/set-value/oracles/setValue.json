{
  "mode": "vectors",
  "exportName": null,
  "unit": "setValue",
  "vectors": [
    {
      "name": "v0",
      "args": [
        {},
        "a",
        1
      ],
      "expected": {
        "a": 1
      }
    },
    {
      "name": "v1",
      "args": [
        {},
        "hello",
        "world"
      ],
      "expected": {
        "hello": "world"
      }
    },
    {
      "name": "v2",
      "args": [
        {},
        "a.b.c",
        5
      ],
      "expected": {
        "a": {
          "b": {
            "c": 5
          }
        }
      }
    },
    {
      "name": "v3",
      "args": [
        {},
        "x.y",
        {
          "z": 1
        }
      ],
      "expected": {
        "x": {
          "y": {
            "z": 1
          }
        }
      }
    },
    {
      "name": "v4",
      "args": [
        {},
        [
          "a",
          "b"
        ],
        7
      ],
      "expected": {
        "a": {
          "b": 7
        }
      }
    },
    {
      "name": "v5",
      "args": [
        {},
        [
          "a",
          "b",
          "c"
        ],
        "deep"
      ],
      "expected": {
        "a": {
          "b": {
            "c": "deep"
          }
        }
      }
    },
    {
      "name": "v6",
      "args": [
        {},
        [
          "a.b",
          "c"
        ],
        1
      ],
      "expected": {
        "a.b": {
          "c": 1
        }
      }
    },
    {
      "name": "v7",
      "args": [
        {
          "a": 1
        },
        [],
        9
      ],
      "expected": {
        "a": 1
      }
    },
    {
      "name": "v8",
      "args": [
        {},
        "a\\.b",
        9
      ],
      "expected": {
        "a.b": 9
      }
    },
    {
      "name": "v9",
      "args": [
        {},
        "a\\.b\\.c",
        2
      ],
      "expected": {
        "a.b.c": 2
      }
    },
    {
      "name": "v10",
      "args": [
        {},
        "a.b\\.c.d",
        3
      ],
      "expected": {
        "a": {
          "b.c": {
            "d": 3
          }
        }
      }
    },
    {
      "name": "v11",
      "args": [
        {
          "a": {
            "b": 1
          }
        },
        "a.b",
        2
      ],
      "expected": {
        "a": {
          "b": 2
        }
      }
    },
    {
      "name": "v12",
      "args": [
        {
          "a": 1
        },
        "a",
        2
      ],
      "expected": {
        "a": 2
      }
    },
    {
      "name": "v13",
      "args": [
        {
          "a": {
            "b": 1,
            "sib": 2
          }
        },
        "a.c",
        3
      ],
      "expected": {
        "a": {
          "b": 1,
          "sib": 2,
          "c": 3
        }
      }
    },
    {
      "name": "v14",
      "args": [
        {
          "a": 5
        },
        "a.b.c",
        1
      ],
      "expected": {
        "a": {
          "b": {
            "c": 1
          }
        }
      }
    },
    {
      "name": "v15",
      "args": [
        {},
        "a.b",
        0
      ],
      "expected": {
        "a": {
          "b": 0
        }
      }
    }
  ],
  "heldout": [
    {
      "name": "v16",
      "args": [
        {},
        "a.b",
        -7
      ],
      "expected": {
        "a": {
          "b": -7
        }
      }
    },
    {
      "name": "v17",
      "args": [
        {},
        "a.b",
        3.14
      ],
      "expected": {
        "a": {
          "b": 3.14
        }
      }
    },
    {
      "name": "v18",
      "args": [
        {},
        "a.b",
        true
      ],
      "expected": {
        "a": {
          "b": true
        }
      }
    },
    {
      "name": "v19",
      "args": [
        {},
        "a.b",
        false
      ],
      "expected": {
        "a": {
          "b": false
        }
      }
    },
    {
      "name": "v20",
      "args": [
        {},
        "a.b",
        "str"
      ],
      "expected": {
        "a": {
          "b": "str"
        }
      }
    },
    {
      "name": "v21",
      "args": [
        {},
        "a.b",
        null
      ],
      "expected": {
        "a": {
          "b": null
        }
      }
    },
    {
      "name": "v22",
      "args": [
        {},
        "a.b",
        {
          "x": 1,
          "y": [
            2,
            3
          ]
        }
      ],
      "expected": {
        "a": {
          "b": {
            "x": 1,
            "y": [
              2,
              3
            ]
          }
        }
      }
    },
    {
      "name": "v23",
      "args": [
        {},
        "a.b",
        [
          1,
          2,
          3
        ]
      ],
      "expected": {
        "a": {
          "b": [
            1,
            2,
            3
          ]
        }
      }
    },
    {
      "name": "v24",
      "args": [
        {},
        "a.b",
        ""
      ],
      "expected": {
        "a": {
          "b": ""
        }
      }
    },
    {
      "name": "v25",
      "args": [
        {
          "a": {
            "b": 1,
            "c": 2
          }
        },
        "a.b",
        {
          "__t": "undef"
        }
      ],
      "expected": {
        "a": {
          "c": 2
        }
      }
    },
    {
      "name": "v26",
      "args": [
        {
          "a": 1
        },
        "a",
        {
          "__t": "undef"
        }
      ],
      "expected": {}
    },
    {
      "name": "v27",
      "args": [
        {},
        "a.b.c",
        {
          "__t": "undef"
        }
      ],
      "expected": {
        "a": {
          "b": {}
        }
      }
    },
    {
      "name": "v28",
      "args": [
        {},
        "a.0.b",
        1
      ],
      "expected": {
        "a": [
          {
            "b": 1
          }
        ]
      }
    }
  ]
}
