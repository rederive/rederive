{
  "mode": "vectors",
  "exportName": null,
  "unit": "stringify",
  "vectors": [
    {
      "name": "v0",
      "args": [
        42
      ],
      "expected": "42"
    },
    {
      "name": "v1",
      "args": [
        -7
      ],
      "expected": "-7"
    },
    {
      "name": "v2",
      "args": [
        0
      ],
      "expected": "0"
    },
    {
      "name": "v3",
      "args": [
        3.14159
      ],
      "expected": "3.14159"
    },
    {
      "name": "v4",
      "args": [
        1e+21
      ],
      "expected": "1e+21"
    },
    {
      "name": "v5",
      "args": [
        1e-7
      ],
      "expected": "1e-7"
    },
    {
      "name": "v6",
      "args": [
        123456789012345680000
      ],
      "expected": "123456789012345680000"
    },
    {
      "name": "v7",
      "args": [
        "hi"
      ],
      "expected": "\"hi\""
    },
    {
      "name": "v8",
      "args": [
        ""
      ],
      "expected": "\"\""
    },
    {
      "name": "v9",
      "args": [
        true
      ],
      "expected": "true"
    },
    {
      "name": "v10",
      "args": [
        false
      ],
      "expected": "false"
    },
    {
      "name": "v11",
      "args": [
        null
      ],
      "expected": "null"
    },
    {
      "name": "v12",
      "args": [
        {
          "a": null
        }
      ],
      "expected": "{\"a\":null}"
    },
    {
      "name": "v13",
      "args": [
        {
          "a": null,
          "b": 1
        }
      ],
      "expected": "{\"a\":null,\"b\":1}"
    },
    {
      "name": "v14",
      "args": [
        [
          null,
          1,
          null
        ]
      ],
      "expected": "[null,1,null]"
    },
    {
      "name": "v15",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": "[1,2,3]"
    }
  ],
  "heldout": [
    {
      "name": "v16",
      "args": [
        {}
      ],
      "expected": "{}"
    },
    {
      "name": "v17",
      "args": [
        []
      ],
      "expected": "[]"
    },
    {
      "name": "v18",
      "args": [
        {
          "a": {},
          "b": []
        }
      ],
      "expected": "{\"a\":{},\"b\":[]}"
    },
    {
      "name": "v19",
      "args": [
        {
          "a": "\"quote\\back\b\f\n\r\t end"
        }
      ],
      "expected": "{\"a\":\"\\\"quote\\\\back\\b\\f\\n\\r\\t end\"}"
    },
    {
      "name": "v20",
      "args": [
        {
          "a": " "
        }
      ],
      "expected": "{\"a\":\" \"}"
    },
    {
      "name": "v21",
      "args": [
        {
          "a": "héllo 😀"
        }
      ],
      "expected": "{\"a\":\"héllo 😀\"}"
    },
    {
      "name": "v22",
      "args": [
        {
          "key\"with\nescapes": 1
        }
      ],
      "expected": "{\"key\\\"with\\nescapes\":1}"
    },
    {
      "name": "v23",
      "args": [
        {
          "": 1
        }
      ],
      "expected": "{\"\":1}"
    },
    {
      "name": "v24",
      "args": [
        {
          "1": "a",
          "2": "b",
          "9": "e",
          "10": "c",
          "x": "d"
        }
      ],
      "expected": "{\"1\":\"a\",\"2\":\"b\",\"9\":\"e\",\"10\":\"c\",\"x\":\"d\"}"
    },
    {
      "name": "v25",
      "args": [
        {
          "a": {
            "b": {
              "c": {
                "d": [
                  1,
                  2,
                  {
                    "e": 3
                  }
                ]
              }
            }
          }
        }
      ],
      "expected": "{\"a\":{\"b\":{\"c\":{\"d\":[1,2,{\"e\":3}]}}}}"
    },
    {
      "name": "v26",
      "args": [
        [
          [
            [
              [
                [
                  1
                ]
              ]
            ]
          ]
        ]
      ],
      "expected": "[[[[[1]]]]]"
    },
    {
      "name": "v27",
      "args": [
        {
          "a": [
            {
              "b": [
                {
                  "c": 1
                }
              ]
            }
          ]
        }
      ],
      "expected": "{\"a\":[{\"b\":[{\"c\":1}]}]}"
    },
    {
      "name": "v28",
      "args": [
        {
          "a": 1,
          "b": 2,
          "c": 3
        },
        [
          "a",
          "c"
        ]
      ],
      "expected": "{\"a\":1,\"c\":3}"
    }
  ]
}
