{
  "mode": "vectors",
  "exportName": null,
  "unit": "extendShallow",
  "vectors": [
    {
      "name": "v0",
      "args": [
        {
          "a": 1
        },
        {
          "b": 2
        }
      ],
      "expected": {
        "a": 1,
        "b": 2
      }
    },
    {
      "name": "v1",
      "args": [
        {},
        {
          "only": "x"
        }
      ],
      "expected": {
        "only": "x"
      }
    },
    {
      "name": "v2",
      "args": [
        {
          "a": 1
        },
        {
          "b": 2
        },
        {
          "b": 3,
          "c": 4
        }
      ],
      "expected": {
        "a": 1,
        "b": 3,
        "c": 4
      }
    },
    {
      "name": "v3",
      "args": [
        {
          "k": 0
        },
        {
          "k": 1
        },
        {
          "k": 2
        },
        {
          "k": 3
        }
      ],
      "expected": {
        "k": 3
      }
    },
    {
      "name": "v4",
      "args": [
        {
          "a": 1
        },
        "hello"
      ],
      "expected": {
        "0": "h",
        "1": "e",
        "2": "l",
        "3": "l",
        "4": "o",
        "a": 1
      }
    },
    {
      "name": "v5",
      "args": [
        {
          "a": 1
        },
        42
      ],
      "expected": {
        "a": 1
      }
    },
    {
      "name": "v6",
      "args": [
        {
          "a": 1
        },
        true
      ],
      "expected": {
        "a": 1
      }
    },
    {
      "name": "v7",
      "args": [
        {
          "a": 1
        },
        false
      ],
      "expected": {
        "a": 1
      }
    },
    {
      "name": "v8",
      "args": [
        {
          "a": 1
        },
        null
      ],
      "expected": {
        "a": 1
      }
    },
    {
      "name": "v9",
      "args": [
        {
          "a": 1
        },
        {
          "__t": "undef"
        }
      ],
      "expected": {
        "a": 1
      }
    },
    {
      "name": "v10",
      "args": [
        {
          "a": 0
        },
        {
          "a": 1
        },
        null,
        {
          "b": 2
        }
      ],
      "expected": {
        "a": 1,
        "b": 2
      }
    },
    {
      "name": "v11",
      "args": [
        {
          "a": 0
        },
        {
          "a": 1
        },
        {
          "__t": "undef"
        },
        {
          "b": 2
        }
      ],
      "expected": {
        "a": 1,
        "b": 2
      }
    },
    {
      "name": "v12",
      "args": [
        {},
        {
          "n": {
            "deep": 1
          }
        }
      ],
      "expected": {
        "n": {
          "deep": 1
        }
      }
    },
    {
      "name": "v13",
      "args": [
        {},
        {
          "arr": [
            1,
            2,
            3
          ]
        }
      ],
      "expected": {
        "arr": [
          1,
          2,
          3
        ]
      }
    },
    {
      "name": "v14",
      "args": [
        {},
        {
          "a": {
            "deep": 1
          }
        },
        {
          "a": {
            "deep": 2
          }
        }
      ],
      "expected": {
        "a": {
          "deep": 2
        }
      }
    },
    {
      "name": "v15",
      "args": [
        {
          "a": 1
        },
        {}
      ],
      "expected": {
        "a": 1
      }
    }
  ],
  "heldout": [
    {
      "name": "v16",
      "args": [
        {
          "a": 1
        }
      ],
      "expected": {
        "a": 1
      }
    },
    {
      "name": "v17",
      "args": [
        {}
      ],
      "expected": {}
    },
    {
      "name": "v18",
      "args": [
        {
          "a": 1
        },
        {},
        {},
        {}
      ],
      "expected": {
        "a": 1
      }
    },
    {
      "name": "v19",
      "args": [
        {},
        [
          "a",
          "b"
        ]
      ],
      "expected": {
        "0": "a",
        "1": "b"
      }
    },
    {
      "name": "v20",
      "args": [
        {
          "x": 1
        },
        [
          "p",
          "q",
          "r"
        ]
      ],
      "expected": {
        "0": "p",
        "1": "q",
        "2": "r",
        "x": 1
      }
    },
    {
      "name": "v21",
      "args": [
        [
          1,
          2
        ],
        {
          "2": 9,
          "foo": "bar"
        }
      ],
      "expected": [
        1,
        2,
        9
      ]
    },
    {
      "name": "v22",
      "args": [
        [],
        {
          "0": "z"
        }
      ],
      "expected": [
        "z"
      ]
    },
    {
      "name": "v23",
      "args": [
        {},
        {}
      ],
      "expected": {}
    },
    {
      "name": "v24",
      "args": [
        {},
        {
          "1": 5,
          "2": 2,
          "10": 4,
          "b": 1,
          "a": 3
        }
      ],
      "expected": {
        "1": 5,
        "2": 2,
        "10": 4,
        "b": 1,
        "a": 3
      }
    },
    {
      "name": "v25",
      "args": [
        null,
        {
          "a": 1
        }
      ],
      "expected": {
        "__throw": "Cannot convert undefined or null to object"
      }
    },
    {
      "name": "v26",
      "args": [
        {
          "__t": "undef"
        },
        {
          "a": 1
        }
      ],
      "expected": {
        "__throw": "Cannot convert undefined or null to object"
      }
    },
    {
      "name": "v27",
      "args": [],
      "expected": {
        "__throw": "Cannot convert undefined or null to object"
      }
    },
    {
      "name": "v28",
      "args": [
        {
          "a": 1,
          "b": 1
        },
        {
          "b": 2,
          "c": 2
        },
        "ab",
        7,
        null,
        [
          "Z"
        ],
        {
          "d": 4
        }
      ],
      "expected": {
        "0": "Z",
        "1": "b",
        "a": 1,
        "b": 2,
        "c": 2,
        "d": 4
      }
    }
  ]
}
