{
  "mode": "vectors",
  "exportName": null,
  "unit": "encodeUrl",
  "vectors": [
    {
      "name": "v0",
      "args": [
        "http://example.com/path"
      ],
      "expected": "http://example.com/path"
    },
    {
      "name": "v1",
      "args": [
        ""
      ],
      "expected": ""
    },
    {
      "name": "v2",
      "args": [
        "ABCabc0189-_.~"
      ],
      "expected": "ABCabc0189-_.~"
    },
    {
      "name": "v3",
      "args": [
        "!*'()-_.~"
      ],
      "expected": "!*'()-_.~"
    },
    {
      "name": "v4",
      "args": [
        ";,/?:@&=+$#"
      ],
      "expected": ";,/?:@&=+$#"
    },
    {
      "name": "v5",
      "args": [
        "http://example.com/foo bar"
      ],
      "expected": "http://example.com/foo%20bar"
    },
    {
      "name": "v6",
      "args": [
        "a b c"
      ],
      "expected": "a%20b%20c"
    },
    {
      "name": "v7",
      "args": [
        " "
      ],
      "expected": "%20"
    },
    {
      "name": "v8",
      "args": [
        "http://example.com/foo%20bar"
      ],
      "expected": "http://example.com/foo%20bar"
    },
    {
      "name": "v9",
      "args": [
        "%20"
      ],
      "expected": "%20"
    },
    {
      "name": "v10",
      "args": [
        "%2520"
      ],
      "expected": "%2520"
    },
    {
      "name": "v11",
      "args": [
        "%41"
      ],
      "expected": "%41"
    },
    {
      "name": "v12",
      "args": [
        "A%41A"
      ],
      "expected": "A%41A"
    },
    {
      "name": "v13",
      "args": [
        "%c3%a9"
      ],
      "expected": "%c3%a9"
    },
    {
      "name": "v14",
      "args": [
        "%"
      ],
      "expected": "%25"
    },
    {
      "name": "v15",
      "args": [
        "a%"
      ],
      "expected": "a%25"
    }
  ],
  "heldout": [
    {
      "name": "v16",
      "args": [
        "100%"
      ],
      "expected": "100%25"
    },
    {
      "name": "v17",
      "args": [
        "%foo"
      ],
      "expected": "%25foo"
    },
    {
      "name": "v18",
      "args": [
        "%G0"
      ],
      "expected": "%25G0"
    },
    {
      "name": "v19",
      "args": [
        "%1G"
      ],
      "expected": "%251G"
    },
    {
      "name": "v20",
      "args": [
        "%2x"
      ],
      "expected": "%252x"
    },
    {
      "name": "v21",
      "args": [
        "%%20"
      ],
      "expected": "%25%2520"
    },
    {
      "name": "v22",
      "args": [
        "%2"
      ],
      "expected": "%2"
    },
    {
      "name": "v23",
      "args": [
        "x%2"
      ],
      "expected": "x%2"
    },
    {
      "name": "v24",
      "args": [
        "%2 "
      ],
      "expected": "%252%20"
    },
    {
      "name": "v25",
      "args": [
        "café"
      ],
      "expected": "caf%C3%A9"
    },
    {
      "name": "v26",
      "args": [
        "日本語"
      ],
      "expected": "%E6%97%A5%E6%9C%AC%E8%AA%9E"
    },
    {
      "name": "v27",
      "args": [
        "http://example.com/😀"
      ],
      "expected": "http://example.com/%F0%9F%98%80"
    },
    {
      "name": "v28",
      "args": [
        "üûàñ"
      ],
      "expected": "%C3%BC%C3%BB%C3%A0%C3%B1"
    },
    {
      "name": "ext13",
      "args": [
        "http://example.com/\ud800"
      ],
      "expected": "http://example.com/%EF%BF%BD"
    },
    {
      "name": "ext14",
      "args": [
        "http://example.com/\udc00"
      ],
      "expected": "http://example.com/%EF%BF%BD"
    },
    {
      "name": "ext15",
      "args": [
        "\ud800"
      ],
      "expected": "%EF%BF%BD"
    },
    {
      "name": "ext16",
      "args": [
        "\udc00"
      ],
      "expected": "%EF%BF%BD"
    },
    {
      "name": "ext17",
      "args": [
        "a\ud800z"
      ],
      "expected": "a%EF%BF%BDz"
    },
    {
      "name": "ext18",
      "args": [
        "a\udc00z"
      ],
      "expected": "a%EF%BF%BDz"
    },
    {
      "name": "ext19",
      "args": [
        "http://x.com/\ud800\ud800"
      ],
      "expected": {
        "__throw": "URI malformed"
      }
    },
    {
      "name": "ext20",
      "args": [
        "\udc00\udc00"
      ],
      "expected": {
        "__throw": "URI malformed"
      }
    },
    {
      "name": "ext21",
      "args": [
        "😀 emoji path"
      ],
      "expected": "%F0%9F%98%80%20emoji%20path"
    },
    {
      "name": "ext22",
      "args": [
        "http://x.com/💩/path"
      ],
      "expected": "http://x.com/%F0%9F%92%A9/path"
    },
    {
      "name": "ext23",
      "args": [
        "   "
      ],
      "expected": "%20%20%20"
    },
    {
      "name": "ext24",
      "args": [
        "%%"
      ],
      "expected": "%25%25"
    },
    {
      "name": "ext25",
      "args": [
        "%ZZ"
      ],
      "expected": "%25ZZ"
    },
    {
      "name": "ext26",
      "args": [
        "http://example.com/already%20encoded"
      ],
      "expected": "http://example.com/already%20encoded"
    },
    {
      "name": "ext27",
      "args": [
        "\ud800%20\udc00"
      ],
      "expected": "%EF%BF%BD%20%EF%BF%BD"
    }
  ]
}
