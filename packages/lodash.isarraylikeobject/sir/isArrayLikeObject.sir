# isArrayLikeObject). The blind re-emitter MUST produce an ES module whose
# DEFAULT export is a single function taking one argument:
#     export default function isArrayLikeObject(value) { ... }
# Re-emit all five inlined helpers (isObjectLike, isArrayLike, isLength,
# isFunction, isObject) exactly as composed above; do NOT import lodash.

